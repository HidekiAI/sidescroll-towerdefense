; The game client scene -- PLAN-2026-10-16-parallax-step4.md section 4.6 (gate G19).
;
; It is a separate scene from main.tscn on purpose: the runtime stretch lives in GameView's
; _ready(), not in the shared project.godot, so the editor panel keeps letterboxing itself at
; whatever size the Simulator tab is.
;
; Not the project's main scene. `editor/project.godot` still runs main.tscn; this one is started
; explicitly (the future game entry point, and how the G19 windowed gate loads it).
;
; WorldView is a Control whose parent here is a plain Node, so its anchors resolve against the
; root window: the game viewport fills the window, which is the point.
[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/game_view.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/world_view.tscn" id="2"]
[ext_resource type="Script" path="res://scripts/camera_controller.gd" id="3"]

[node name="Game" type="Node"]
script = ExtResource("1")

[node name="WorldView" parent="." instance=ExtResource("2")]

[node name="CameraController" type="Node" parent="."]
script = ExtResource("3")
