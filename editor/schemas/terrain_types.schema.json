{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TerrainTypesFile",
  "type": "object",
  "required": [
    "tiles",
    "version"
  ],
  "properties": {
    "tiles": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/TerrainTypeDef"
      }
    },
    "version": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "HazardType": {
      "type": "string",
      "enum": [
        "none",
        "lava"
      ]
    },
    "SurfaceType": {
      "type": "string",
      "enum": [
        "normal",
        "ice",
        "mud"
      ]
    },
    "TerrainTypeDef": {
      "type": "object",
      "required": [
        "color_hex",
        "display_name",
        "elevation_tiles",
        "hazard",
        "is_buildable",
        "is_walkable",
        "key",
        "surface"
      ],
      "properties": {
        "color_hex": {
          "type": "string"
        },
        "destructible_hp": {
          "default": 0,
          "type": "integer",
          "format": "int32"
        },
        "display_name": {
          "type": "string"
        },
        "elevation_tiles": {
          "type": "integer",
          "format": "int32"
        },
        "hazard": {
          "$ref": "#/definitions/HazardType"
        },
        "hazard_damage_per_tick": {
          "default": 0,
          "type": "integer",
          "format": "int32"
        },
        "is_buildable": {
          "type": "boolean"
        },
        "is_destructible": {
          "default": false,
          "type": "boolean"
        },
        "is_walkable": {
          "type": "boolean"
        },
        "key": {
          "type": "string"
        },
        "on_destroy_terrain_key": {
          "default": "",
          "type": "string"
        },
        "sub_tile_mask": {
          "default": 15,
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "surface": {
          "$ref": "#/definitions/SurfaceType"
        }
      },
      "additionalProperties": false
    }
  }
}